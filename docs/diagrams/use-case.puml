
@startuml
left to right direction
skinparam packageStyle rectangle

title Кинотеатрдың ақпараттық жүйесі - Use Case Diagram

actor "Көрермен" as Viewer
actor "Кинотеатр әкімшісі" as Admin
actor "Жүйе администраторы" as SysAdmin
actor "Төлем жүйесі" as Payment

rectangle "Кинотеатрдың ақпараттық жүйесі" {

  usecase "Жүйеге кіру" as UC1
  usecase "Фильмдерді қарау" as UC2
  usecase "Фильмді іздеу" as UC3
  usecase "Сеанс таңдау" as UC4
  usecase "Орын таңдау" as UC5
  usecase "Билет брондау" as UC6
  usecase "Билет сатып алу" as UC7
  usecase "Төлем жасау" as UC8
  usecase "Электрондық билет алу" as UC9

  usecase "Фильмдерді басқару" as UC10
  usecase "Сеанстарды басқару" as UC11
  usecase "Билет бағаларын басқару" as UC12
  usecase "Сатылым есебін қарау" as UC13

  usecase "Пайдаланушыларды басқару" as UC14
  usecase "Жүйені басқару" as UC15
}

Viewer --> UC1
Viewer --> UC2
Viewer --> UC3
Viewer --> UC4
Viewer --> UC5
Viewer --> UC6
Viewer --> UC7
Viewer --> UC9

Admin --> UC1
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13

SysAdmin --> UC1
SysAdmin --> UC14
SysAdmin --> UC15

Payment --> UC8

UC7 ..> UC4 : <<include>>
UC7 ..> UC5 : <<include>>
UC7 ..> UC8 : <<include>>
UC7 ..> UC9 : <<include>>

@enduml

